<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JsonToolbox.App.ViewModels"
        xmlns:ctl="using:JsonToolbox.App.Controls"
        x:Class="JsonToolbox.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icon.ico"
        Width="1360" Height="860"
        MinWidth="960" MinHeight="620"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding ActiveDocument.SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding ActiveDocument.UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding ActiveDocument.RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding ActiveDocument.RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding SwitchViewCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <!-- How one side of a diff row is drawn. Shared by both columns so the two halves are
         rendered by the same code and cannot drift apart in appearance. -->
    <DataTemplate x:Key="DiffSideTemplate" x:DataType="vm:DiffSideViewModel">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2">
        <TextBlock Grid.Column="0" Classes="key" Text="{Binding Header}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text=" : " Margin="0,0,3,0"
                   Foreground="{DynamicResource TextTertiary}"
                   IsVisible="{Binding ShowsPreview}" VerticalAlignment="Center" />
        <ctl:DiffValueTextBlock Grid.Column="2"
                                Classes="value"
                                Classes.string="{Binding IsString}"
                                Classes.number="{Binding IsNumber}"
                                Classes.boolean="{Binding IsBoolean}"
                                Classes.nullvalue="{Binding IsNull}"
                                Classes.container="{Binding IsContainerKind}"
                                Classes.markadded="{Binding IsRight}"
                                Classes.markremoved="{Binding IsLeft}"
                                Text="{Binding Preview}"
                                Counterpart="{Binding Counterpart}"
                                IsVisible="{Binding ShowsPreview}"
                                FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Border Grid.Column="3" Classes="chip" Margin="8,0,4,0"
                IsVisible="{Binding CountBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding CountBadge}" />
        </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- ===================================================================== Toolbar -->

    <Border Classes="toolbar" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding OpenCommand}" ToolTip.Tip="Open a JSON document (Ctrl+O)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
              <TextBlock Text="Open" />
            </StackPanel>
          </Button>

          <Button Classes="accent"
                  Command="{Binding ActiveDocument.InspectCommand}"
                  IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="Read the whole document and report problems and structure">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconInspect}" Width="14" Height="14" />
              <TextBlock Text="Inspect" />
            </StackPanel>
          </Button>

          <Button Command="{Binding CompareCommand}"
                  ToolTip.Tip="Open the comparison panel and choose the two documents to compare, by structure rather than by text">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconCompare}" Width="13" Height="13" />
              <TextBlock Text="Compare…" />
            </StackPanel>
          </Button>

          <Border Width="1" Height="20" Margin="2,0" Background="{DynamicResource BorderSubtle}" />

          <Button Classes="quiet" Content="↶" FontSize="15" ToolTip.Tip="Undo"
                  Command="{Binding ActiveDocument.UndoCommand}" IsEnabled="{Binding ActiveDocument.CanUndo}" />
          <Button Classes="quiet" Content="↷" FontSize="15" ToolTip.Tip="Redo"
                  Command="{Binding ActiveDocument.RedoCommand}" IsEnabled="{Binding ActiveDocument.CanRedo}" />
          <Button Content="Save" Command="{Binding ActiveDocument.SaveCommand}"
                  IsEnabled="{Binding ActiveDocument.IsModified}"
                  ToolTip.Tip="Write the changes back to the file" />
        </StackPanel>

        <!-- Search: the field carries its own icon and the modifiers sit inside it, so the
             whole query reads as one control rather than as a field plus a row of settings. -->
        <Border Grid.Column="1"
                Margin="16,0"
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource SurfaceSunken}"
                CornerRadius="{StaticResource ControlRadius}"
                Padding="4">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">

            <PathIcon Grid.Column="0"
                      Data="{StaticResource IconSearch}"
                      Width="13" Height="13"
                      Margin="8,0,4,0"
                      Foreground="{DynamicResource TextTertiary}" />

            <!-- One box for whatever is on screen: it searches the document on a document tab
                 and narrows the differences on the comparison tab. The modifiers below belong
                 to searching a file, so they step aside when the comparison is what is being
                 looked at, where the filter is over what has already been found. -->
            <TextBox Grid.Column="1"
                     Classes="flat"
                     Watermark="{Binding SearchWatermark}"
                     Text="{Binding SearchText}"
                     IsEnabled="{Binding CanSearch}"
                     VerticalAlignment="Center">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>

            <TextBlock Grid.Column="2" Classes="caption" Margin="6,0"
                       Text="{Binding SearchSummary}"
                       IsVisible="{Binding IsSearchingComparison}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                        IsVisible="{Binding !IsSearchingComparison}">
              <ToggleButton Classes="chip" Content="Aa" IsChecked="{Binding ActiveDocument.CaseSensitive}" ToolTip.Tip="Match case" />
              <ToggleButton Classes="chip" Content=".*" IsChecked="{Binding ActiveDocument.UseRegex}" ToolTip.Tip="Regular expression" />
              <ToggleButton Classes="chip" Content="ab|" IsChecked="{Binding ActiveDocument.WholeWord}" ToolTip.Tip="Whole word" />
              <Border Width="1" Height="16" Margin="4,0" Background="{DynamicResource BorderStrong}" />
              <ToggleButton Classes="chip" Content="keys" IsChecked="{Binding ActiveDocument.SearchKeys}" ToolTip.Tip="Search property names" />
              <ToggleButton Classes="chip" Content="values" IsChecked="{Binding ActiveDocument.SearchValues}" ToolTip.Tip="Search values" />
            </StackPanel>

            <Button Grid.Column="3"
                    Classes="accent"
                    Content="Find"
                    Height="26"
                    Margin="6,0,0,0"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding CanSearch}"
                    IsVisible="{Binding !IsSearchingComparison}" />
          </Grid>
        </Border>

        <Button Grid.Column="2"
                Classes="quiet"
                Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="Switch between light, dark and system theme"
                VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconTheme}" Width="15" Height="15" />
        </Button>

      </Grid>
    </Border>

    <!-- ================================================================ Workspace tabs -->

    <Border DockPanel.Dock="Top" Padding="12,0"
            Background="{DynamicResource SurfaceBase}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            IsVisible="{Binding HasDocument}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="2">

          <!-- One tab per open file. The mark on a modified tab is the same one the window
               title carries, so the two never disagree about which file has unsaved work. -->
          <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentSession">
                <Button Classes="tab" Classes.active="{Binding IsActive}"
                        Command="{Binding ActivateCommand}"
                        ToolTip.Tip="{Binding Name}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource IconDocument}" Width="11" Height="11" />
                    <TextBlock Text="{Binding TabTitle}" />
                    <Button Classes="tabclose" Content="✕"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close this document" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Classes="tab" Classes.active="{Binding IsDiffOpen}"
                  Command="{Binding ShowComparisonCommand}"
                  IsVisible="{Binding HasComparison}"
                  ToolTip.Tip="The two documents side by side — Ctrl+Tab cycles the tabs">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconCompare}" Width="11" Height="11" />
              <TextBlock Text="{Binding Comparison.TabTitle}" />
              <Button Classes="tabclose" Content="✕"
                      Command="{Binding CloseComparisonCommand}"
                      ToolTip.Tip="Close the comparison" />
            </StackPanel>
          </Button>

          <Button Classes="quiet" Content="+" FontSize="16" Margin="6,0,0,0"
                  Command="{Binding OpenCommand}"
                  ToolTip.Tip="Open another file (Ctrl+O)" />

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- =================================================================== Status bar -->

    <Border Classes="statusbar" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsVisible="{Binding HasDocument}">
          <PathIcon Data="{StaticResource IconDocument}" Width="12" Height="12"
                    Foreground="{DynamicResource TextTertiary}" />
          <TextBlock Text="{Binding ActiveDocument.Name}" FontWeight="Medium" VerticalAlignment="Center" />
          <Border Classes="chip">
            <TextBlock Text="{Binding ActiveDocument.DocumentSize}" />
          </Border>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Classes="secondary"
                   Text="{Binding StatusText}"
                   Margin="14,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <ProgressBar Grid.Column="2"
                     Width="120" Height="3" Margin="0,0,12,0"
                     Minimum="0" Maximum="1" Value="{Binding Progress}"
                     IsVisible="{Binding IsBusy}"
                     VerticalAlignment="Center" />

        <TextBlock Grid.Column="3"
                   Classes="caption"
                   Text="{Binding Version, StringFormat='v{0}'}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ======================================================================== Body -->

    <Panel>

      <!-- Empty state. Shown instead of two blank panes, and doubles as the drop target
           hint, because dragging a file in is the fastest way to start. -->
      <Border>
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!HasDocument" />
            <Binding Path="!IsDiffOpen" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="380">

          <!-- Braces rather than a page icon: at this size a glyph reads as the subject of
               the application, where a generic document silhouette reads as nothing. -->
          <Border Width="76" Height="76" CornerRadius="16"
                  Background="{DynamicResource AccentSoft}"
                  HorizontalAlignment="Center">
            <!-- The leading {} is the XAML escape that stops a literal brace from being read
                 as the start of a markup extension. -->
            <TextBlock Text="{}{ }"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="30" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBase}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <TextBlock Text="No document open"
                     FontSize="16" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="secondary"
                     Text="Drop a JSON file here, or open one. Files of any size are welcome — nothing is read until you look at it."
                     TextWrapping="Wrap" TextAlignment="Center" />
          <Button Classes="accent" Content="Open a file…"
                  Command="{Binding OpenCommand}"
                  HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- ================================================================ Side by side -->

      <DockPanel Margin="10"
                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsDiffOpen}"
                 DataContext="{Binding Comparison}" x:DataType="vm:ComparisonViewModel">

        <!-- What is being compared is chosen here rather than assumed. Each side offers the
             documents that are already open, and a button for anything else on disk. -->
        <Border Classes="panel" DockPanel.Dock="Top" Padding="12,10" Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">

            <TextBlock Grid.Row="0" Grid.Column="0" Classes="sectionTitle" Text="LEFT"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="200"
                      ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding Left}"
                      PlaceholderText="choose a document"
                      DisplayMemberBinding="{Binding Name}" />
            <Button Grid.Row="0" Grid.Column="2" Classes="quiet" Margin="4,0,16,0"
                    Command="{Binding BrowseLeftCommand}"
                    ToolTip.Tip="Compare against a file that is not open">
              <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
            </Button>

            <TextBlock Grid.Row="0" Grid.Column="3" Classes="sectionTitle" Text="RIGHT"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Row="0" Grid.Column="4" MinWidth="200"
                      ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding Right}"
                      PlaceholderText="choose a document"
                      DisplayMemberBinding="{Binding Name}" />
            <Button Grid.Row="0" Grid.Column="5" Classes="quiet" Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding BrowseRightCommand}"
                    ToolTip.Tip="Compare against a file that is not open">
              <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
            </Button>

            <ToggleButton Grid.Row="0" Grid.Column="6" Classes="chip" Content="changes only"
                          IsChecked="{Binding Tree.ChangesOnly}"
                          IsVisible="{Binding HasResult}"
                          ToolTip.Tip="Hide the values the two documents agree on"
                          VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.ColumnSpan="7" Classes="caption" Margin="0,8,0,0"
                       Text="{Binding Summary}" TextWrapping="Wrap"
                       IsVisible="{Binding HasResult}" />
          </Grid>
        </Border>

        <Border Classes="panel">
          <Panel>

            <!-- Before both sides are chosen the panel says what it is waiting for, rather
                 than showing two empty columns under two empty headings. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" MaxWidth="380"
                        IsVisible="{Binding !HasResult}">
              <TextBlock Text="Nothing compared yet"
                         FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="secondary"
                         Text="Choose a document on each side above. Either can be one that is already open — including its unsaved edits — or any other file on disk."
                         TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <DockPanel IsVisible="{Binding HasResult}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,1,*">
              <Border Grid.Column="0" Classes="paneHeader" BorderThickness="0,0,0,1">
                <TextBlock Classes="sectionTitle" Text="{Binding Tree.LeftName}" VerticalAlignment="Center" />
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource BorderSubtle}" />
              <Border Grid.Column="2" Classes="paneHeader" BorderThickness="0,0,0,1">
                <TextBlock Classes="sectionTitle" Text="{Binding Tree.RightName}" VerticalAlignment="Center" />
              </Border>
            </Grid>

            <!-- One list, two columns. A row is a pair, so the two halves cannot drift apart
                 and there is no scrolling to keep in step. -->
            <ListBox ItemsSource="{Binding Tree.Rows}" Classes="rows diffrows">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JsonDiffRowViewModel">

                  <!-- The tint lives on a Border rather than being set on the Grid: a value
                       written straight onto the control would beat the style that carries it. -->
                  <Border Classes="diffrow"
                          Classes.added="{Binding IsAdded}"
                          Classes.removed="{Binding IsRemoved}"
                          Classes.changed="{Binding IsChanged}">
                    <Grid ColumnDefinitions="*,1,*">

                      <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="{Binding IndentMargin}">
                        <Button Grid.Column="0" Classes="expander"
                                Classes.open="{Binding IsExpanded}"
                                Command="{Binding ToggleCommand}"
                                IsVisible="{Binding ShowsLeftExpander}">
                          <PathIcon Data="{StaticResource IconChevron}" Width="8" Height="8" />
                        </Button>

                        <ContentControl Grid.Column="1" Content="{Binding Left}"
                                        IsVisible="{Binding HasLeft}"
                                        ContentTemplate="{StaticResource DiffSideTemplate}" />

                        <Button Grid.Column="1" Classes="quiet more"
                                IsVisible="{Binding IsMoreRow}"
                                IsEnabled="{Binding CanShowMore}"
                                Content="{Binding MoreText}"
                                Command="{Binding ShowMoreChildrenCommand}"
                                HorizontalAlignment="Left" />
                      </Grid>

                      <Border Grid.Column="1" Background="{DynamicResource BorderSubtle}" />

                      <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Margin="{Binding IndentMargin}">
                        <Button Grid.Column="0" Classes="expander"
                                Classes.open="{Binding IsExpanded}"
                                Command="{Binding ToggleCommand}"
                                IsVisible="{Binding ShowsRightExpander}">
                          <PathIcon Data="{StaticResource IconChevron}" Width="8" Height="8" />
                        </Button>

                        <ContentControl Grid.Column="1" Content="{Binding Right}"
                                        IsVisible="{Binding HasRight}"
                                        ContentTemplate="{StaticResource DiffSideTemplate}" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
          </Panel>
        </Border>
      </DockPanel>

      <!-- The open document, whichever tab is on. Everything inside binds to that document's
           own session, so switching tabs changes which session is shown and nothing else. -->
      <ContentControl Content="{Binding ActiveDocument}">
        <ContentControl.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="HasDocument" />
            <Binding Path="!IsDiffOpen" />
          </MultiBinding>
        </ContentControl.IsVisible>
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:DocumentSession">

      <Grid ColumnDefinitions="2*,6,3*" Margin="10,10,10,10">

        <!-- =================================================================== Tree -->

        <Border Grid.Column="0" Classes="panel">
          <DockPanel>
            <Border Classes="paneHeader" DockPanel.Dock="Top">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="DOCUMENT" VerticalAlignment="Center" />

                <!-- How the properties of an object are listed. This is a way of looking at the
                     document; Apply is what writes the order into it. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                  <ToggleButton Classes="chip" Content="file order" IsChecked="{Binding IsFileOrder}"
                                ToolTip.Tip="List properties in the order the file writes them" />
                  <ToggleButton Classes="chip" Content="A→Z" IsChecked="{Binding IsAscending}"
                                ToolTip.Tip="List the properties of every object by name, A to Z" />
                  <ToggleButton Classes="chip" Content="Z→A" IsChecked="{Binding IsDescending}"
                                ToolTip.Tip="List the properties of every object by name, Z to A" />
                  <!-- Named for what it applies: the value pane has an Apply of its own, and
                       two buttons reading "Apply" in one window is one too many. -->
                  <Button Classes="quiet" Content="Apply order" FontSize="11"
                          Height="22" Margin="4,0,0,0" VerticalAlignment="Center"
                          Command="{Binding ApplyOrderCommand}"
                          IsVisible="{Binding CanApplyOrder}"
                          ToolTip.Tip="Write this order into the document itself, as an edit you can undo" />

                  <!-- Said where the document is, not only in the status bar: it changes what
                       the rows below mean, and a status message is read once. -->
                  <Border Classes="chip" Margin="10,0,0,0" VerticalAlignment="Center"
                          IsVisible="{Binding IsSequence}"
                          ToolTip.Tip="This file holds one document per line rather than a single document. The records are shown as a list of them.">
                    <TextBlock Text="sequence" />
                  </Border>

                  <Border Classes="chip" Margin="10,0,0,0" VerticalAlignment="Center"
                          IsVisible="{Binding IsReadLeniently}"
                          ToolTip.Tip="This file is not portable JSON. It is being read with comments and trailing commas allowed; run Inspect to see what is in it.">
                    <TextBlock Text="comments allowed" />
                  </Border>
                </StackPanel>

                <!-- What is currently pinned, and the way back out. Right-clicking a property
                     in the tree is how a name gets in here. -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Pinned.Ordered}"
                              Margin="12,0" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="chip pin">
                        <TextBlock Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Column="3" Classes="quiet" Content="Clear pins" FontSize="11"
                        Height="22" VerticalAlignment="Center"
                        Command="{Binding ClearPinsCommand}"
                        IsVisible="{Binding !Pinned.IsEmpty}" />
              </Grid>
            </Border>

            <!--
              A flat list, not a tree control. Every row is one line tall, so the virtualising
              panel knows exactly how long the list is instead of estimating from an average
              that one expanded branch would throw off. Nesting is drawn from each row's depth.
            -->
            <ListBox Name="TreeRows"
                     ItemsSource="{Binding Tree.Rows}"
                     SelectedItem="{Binding SelectedNode}"
                     Classes="rows">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JsonNodeViewModel">
                  <!-- The transparent background is what makes the row hit-testable across
                       its whole width. Without it a right-click between two pieces of text
                       falls through to the list item, which has no menu of its own. -->
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                        Margin="{Binding IndentMargin}"
                        Background="Transparent">

                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding PinMenuHeader}"
                                  Command="{Binding TogglePinCommand}"
                                  IsEnabled="{Binding CanPin}" />
                        <Separator />
                        <MenuItem Header="Add member…"
                                  Command="{Binding $parent[ListBox].((vm:DocumentSession)DataContext).AddChildCommand}"
                                  IsEnabled="{Binding CanExpand}" />
                        <MenuItem Header="Rename property…"
                                  Command="{Binding $parent[ListBox].((vm:DocumentSession)DataContext).RenameSelectedCommand}"
                                  IsEnabled="{Binding CanPin}" />
                        <MenuItem Header="Delete"
                                  Command="{Binding $parent[ListBox].((vm:DocumentSession)DataContext).DeleteSelectedCommand}" />
                        <Separator />
                        <MenuItem Header="Sort properties here"
                                  Command="{Binding $parent[ListBox].((vm:DocumentSession)DataContext).ApplyOrderCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding CanExpand}" />
                      </ContextMenu>
                    </Grid.ContextMenu>

                    <!-- The expander is drawn per row rather than by the control, because a
                         flat list has no idea that one row contains another. -->
                    <Button Grid.Column="0" Classes="expander"
                            Classes.open="{Binding IsExpanded}"
                            Command="{Binding ToggleCommand}"
                            IsVisible="{Binding CanExpand}">
                      <PathIcon Data="{StaticResource IconChevron}" Width="8" Height="8" />
                    </Button>

                    <Panel Grid.Column="1" IsVisible="{Binding !IsMoreRow}">
                      <TextBlock Classes="key" Text="{Binding Header}" VerticalAlignment="Center" />
                    </Panel>

                    <!-- The separator belongs to the value, not to the key, so a row with
                         nothing to show on the right does not end in a dangling colon. -->
                    <TextBlock Grid.Column="2" Text=" : " Margin="0,0,3,0"
                               Foreground="{DynamicResource TextTertiary}"
                               IsVisible="{Binding ShowsPreview}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="3" Classes="quiet more"
                            IsVisible="{Binding IsMoreRow}"
                            IsEnabled="{Binding CanShowMore}"
                            Content="{Binding MoreText}"
                            Command="{Binding ShowMoreChildrenCommand}"
                            HorizontalAlignment="Left" />

                    <ctl:HighlightTextBlock Grid.Column="3"
                                              Classes="value"
                                              Classes.string="{Binding IsString}"
                                              Classes.number="{Binding IsNumber}"
                                              Classes.boolean="{Binding IsBoolean}"
                                              Classes.nullvalue="{Binding IsNull}"
                                              Classes.container="{Binding IsContainerKind}"
                                              Text="{Binding Preview}"
                                              IsVisible="{Binding ShowsPreview}"
                                              Highlight="{Binding Highlight}"
                                              MatchBackground="{DynamicResource MatchBackground}"
                                              MatchForeground="{DynamicResource MatchForeground}"
                                              FontFamily="{StaticResource MonoFont}"
                                              FontSize="12.5"
                                              TextTrimming="CharacterEllipsis"
                                              VerticalAlignment="Center" />

                    <!-- Pinned properties of a collapsed container, so the record can be
                         told apart without opening it. -->
                    <ctl:HighlightTextBlock Grid.Column="4"
                                            Classes="pinned"
                                            Text="{Binding PinnedSummary}"
                                            IsVisible="{Binding HasPinnedSummary}"
                                            Highlight="{Binding Highlight}"
                                            MatchBackground="{DynamicResource MatchBackground}"
                                            MatchForeground="{DynamicResource MatchForeground}"
                                            Margin="12,0,0,0"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />

                    <Border Grid.Column="5" Classes="chip" Margin="8,0,4,0"
                            IsVisible="{Binding CountBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding CountBadge}" />
                    </Border>

                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- ============================================================ Side panels -->

        <Border Grid.Column="2" Classes="panel">
          <TabControl SelectedIndex="{Binding SelectedPanel}">

            <!-- ................................................................ Value -->
            <TabItem Header="Value">
              <DockPanel>

                <Border DockPanel.Dock="Top" Padding="14,12"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding HasSelection}">
                  <StackPanel Spacing="10">

                    <StackPanel Spacing="4">
                      <TextBlock Classes="sectionTitle" Text="PATH" />
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <SelectableTextBlock Grid.Column="0" Classes="path" Text="{Binding SelectedPath}"
                                             TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="quiet" Content="Copy" FontSize="11" Height="24"
                                Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy the JSONPath" />
                        <Button Grid.Column="2" Classes="quiet" Content="Pointer" FontSize="11" Height="24"
                                Command="{Binding CopyPointerCommand}"
                                ToolTip.Tip="{Binding SelectedPointer, StringFormat='Copy the JSON Pointer: {0}'}" />
                      </Grid>
                    </StackPanel>

                    <!-- Metadata as a row of labelled facts rather than a wall of text: the
                         four numbers are read at a glance and never together. -->
                    <UniformGrid Columns="4">
                      <StackPanel Spacing="1">
                        <TextBlock Classes="caption" Text="Type" />
                        <TextBlock Text="{Binding SelectedType}" FontWeight="Medium" />
                      </StackPanel>
                      <StackPanel Spacing="1">
                        <TextBlock Classes="caption" Text="Size" />
                        <TextBlock Text="{Binding SelectedSize}" FontWeight="Medium" />
                      </StackPanel>
                      <StackPanel Spacing="1">
                        <TextBlock Classes="caption" Text="Line" />
                        <TextBlock Text="{Binding SelectedLine}" FontWeight="Medium" />
                      </StackPanel>
                      <StackPanel Spacing="1">
                        <TextBlock Classes="caption" Text="Children" />
                        <TextBlock Text="{Binding SelectedChildren}" FontWeight="Medium" />
                      </StackPanel>
                    </UniformGrid>

                  </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="14,8"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding HasSelection}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Text="{Binding EditError}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SeverityError}"
                               IsVisible="{Binding EditError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="accent" Content="Apply" Height="26" FontSize="12"
                              Command="{Binding ApplyValueCommand}"
                              IsVisible="{Binding CanEditValue}" />
                      <Button Content="Revert" Height="26" FontSize="12"
                              Command="{Binding RevertValueCommand}"
                              IsVisible="{Binding CanEditValue}" />
                      <Button Classes="quiet" Content="Copy value" FontSize="11.5"
                              Command="{Binding CopyValueCommand}" />

                      <!-- Only for a string that turned out to hold a document of its own.
                           Reading one of those through its escapes is what this saves. -->
                      <ToggleButton Classes="chip" Content="decoded"
                                    IsChecked="{Binding ShowDecoded}"
                                    IsVisible="{Binding HasEmbeddedJson}"
                                    ToolTip.Tip="This string holds a JSON document. Show it as the document it is." />

                      <TextBlock Classes="caption" VerticalAlignment="Center"
                                 IsVisible="{Binding !CanEditValue}"
                                 Text="Too large to edit as text." />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Panel>
                  <TextBlock Classes="secondary" MaxWidth="280"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding !HasSelection}"
                             Text="Select a value in the tree to see its path, its position in the file, and its text." />

                  <!-- Read-only rendering, so the search term can be marked up inside the
                       value: a TextBox draws one uniform run. -->
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasSelection" />
                        <Binding Path="!CanEditValue" />
                        <Binding Path="!ShowDecoded" />
                      </MultiBinding>
                    </ScrollViewer.IsVisible>
                    <ctl:HighlightTextBlock Margin="14"
                                            Text="{Binding SelectedNodeDetail}"
                                            Highlight="{Binding Highlight}"
                                            MatchBackground="{DynamicResource MatchBackground}"
                                            MatchForeground="{DynamicResource MatchForeground}"
                                            FontFamily="{StaticResource MonoFont}"
                                            FontSize="12.5"
                                            TextWrapping="NoWrap" />
                  </ScrollViewer>

                  <!-- The same value, editable. Whatever is typed here is parsed before it is
                       allowed anywhere near the document. -->
                  <TextBox Classes="code"
                           Text="{Binding EditedValue}"
                           AcceptsReturn="True" TextWrapping="NoWrap">
                    <TextBox.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanEditValue" />
                        <Binding Path="!ShowDecoded" />
                      </MultiBinding>
                    </TextBox.IsVisible>
                  </TextBox>

                  <!-- The document the string holds, read out. Not editable: what is written
                       here would have to be escaped back into the string it came from, which is
                       a different operation from changing a value and would have to say so. -->
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                IsVisible="{Binding ShowDecoded}">
                    <ctl:HighlightTextBlock Margin="14"
                                            Text="{Binding DecodedValue}"
                                            Highlight="{Binding Highlight}"
                                            MatchBackground="{DynamicResource MatchBackground}"
                                            MatchForeground="{DynamicResource MatchForeground}"
                                            FontFamily="{StaticResource MonoFont}"
                                            FontSize="12.5"
                                            TextWrapping="NoWrap" />
                  </ScrollViewer>
                </Panel>
              </DockPanel>
            </TabItem>

            <!-- ................................................................ Table -->
            <TabItem Header="Table">
              <DockPanel>

                <Border DockPanel.Dock="Top" Padding="14,10"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding HasTable}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Classes="path" Text="{Binding Table.Path}" />
                      <TextBlock Classes="caption" Text="{Binding Table.Summary}" />
                    </StackPanel>

                    <!-- Narrows the records the table holds, which is a different question from
                         the toolbar's search over the whole file. -->
                    <Border Grid.Column="1" Width="200" VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceSunken}"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="4">
                      <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconSearch}"
                                  Width="11" Height="11" Margin="6,0,4,0"
                                  Foreground="{DynamicResource TextTertiary}" />
                        <TextBox Grid.Column="1" Classes="flat" FontSize="12"
                                 Watermark="Filter these records…"
                                 Text="{Binding Table.Filter}"
                                 VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="14,8"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding Table.HasMore}">
                  <!-- The label is a TextBlock rather than the button's Content: bound to
                       Content it measured as nothing and the button came out sixteen pixels
                       wide, holding text that was there and invisible. -->
                  <Button Classes="quiet" Height="24"
                          Command="{Binding Table.ShowMoreCommand}"
                          HorizontalAlignment="Left">
                    <TextBlock FontSize="11" Text="{Binding Table.MoreText}" VerticalAlignment="Center" />
                  </Button>
                </Border>

                <Panel>
                  <TextBlock Classes="secondary" MaxWidth="340"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding TableMessage}"
                             IsVisible="{Binding !HasTable}" />

                  <!-- Header and rows scroll together in one horizontal viewer, and the columns
                       are a fixed width apiece, so the two line up without a shared grid that
                       would have to be kept in step. -->
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                IsVisible="{Binding HasTable}">
                    <DockPanel>

                      <Border DockPanel.Dock="Top" Classes="tablehead">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="tablecorner" Text="#" />
                          <ItemsControl ItemsSource="{Binding Table.Columns}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:TableColumnViewModel">
                                <!-- The heading is the control that sorts, because that is where
                                     everyone reaches for it. Three states: up, down, and back to
                                     the order the file writes. -->
                                <Button Classes="tableheadcell"
                                        Classes.sorted="{Binding IsSorted}"
                                        Width="{Binding Width}"
                                        Command="{Binding CycleSortCommand}"
                                        ToolTip.Tip="Sort by this column; again to reverse it, again for the order of the file">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Marker}" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>

                      <ListBox ItemsSource="{Binding Table.Rows}"
                               SelectedItem="{Binding Table.SelectedRow}"
                               Classes="rows">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:TableRowViewModel">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                              <StackPanel.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Show this record in the tree"
                                            Command="{Binding $parent[ListBox].((vm:DocumentSession)DataContext).RevealTableRowCommand}"
                                            CommandParameter="{Binding}" />
                                </ContextMenu>
                              </StackPanel.ContextMenu>

                              <TextBlock Classes="tablecorner" Text="{Binding Label}" />
                              <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:TableCellViewModel">
                                    <TextBlock Classes="value tablecell"
                                               Classes.string="{Binding IsString}"
                                               Classes.number="{Binding IsNumber}"
                                               Classes.boolean="{Binding IsBoolean}"
                                               Classes.nullvalue="{Binding IsNull}"
                                               Classes.container="{Binding IsContainerKind}"
                                               Width="{Binding Width}"
                                               Text="{Binding Text}"
                                               TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                    </DockPanel>
                  </ScrollViewer>
                </Panel>

              </DockPanel>
            </TabItem>

            <!-- ............................................................. Problems -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="Problems" VerticalAlignment="Center" />
                  <Border Classes="chip" IsVisible="{Binding HasDiagnostics}">
                    <TextBlock Text="{Binding DiagnosticCountText}" />
                  </Border>
                </StackPanel>
              </TabItem.Header>

              <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="300"
                           IsVisible="{Binding !HasInspected}">
                  <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                             Text="Run Inspect to read the whole document and report what is wrong with it." />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="300">
                  <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="HasInspected" />
                      <Binding Path="!HasDiagnostics" />
                    </MultiBinding>
                  </StackPanel.IsVisible>
                  <TextBlock Text="Nothing to report" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                             Text="No syntax errors and no values that will be misread downstream." />
                </StackPanel>

                <ListBox ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding SelectedDiagnostic}"
                         IsVisible="{Binding HasDiagnostics}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosticRowViewModel">
                      <StackPanel Spacing="5">

                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Border Classes="severity"
                                  Classes.error="{Binding IsError}"
                                  Classes.warning="{Binding IsWarning}"
                                  Classes.info="{Binding IsInfo}">
                            <TextBlock Text="{Binding SeverityLabel}" />
                          </Border>
                          <TextBlock Classes="caption" Text="{Binding Code}" VerticalAlignment="Center" />
                          <Border Classes="chip" IsVisible="{Binding IsFolded}">
                            <TextBlock Text="{Binding OccurrenceText}" />
                          </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        <TextBlock Classes="path" Text="{Binding Path}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Hint}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasHint}" />

                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Panel>
            </TabItem>

            <!-- ............................................................ Structure -->
            <TabItem Header="Structure">
              <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,10"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding HasInspected}">
                  <TextBlock Classes="caption" Text="{Binding InspectionSummary}" />
                </Border>

                <Panel>
                  <TextBlock Classes="secondary" MaxWidth="300"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding !HasInspected}"
                             Text="Run Inspect to infer the shape of the document, with the share of bytes each path accounts for." />

                  <ListBox ItemsSource="{Binding Profile}" IsVisible="{Binding HasInspected}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PathRowViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">

                          <TextBlock Grid.Row="0" Grid.Column="0" Classes="path" Text="{Binding Path}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption" Text="{Binding CountText}"
                                     Margin="10,0,0,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="{Binding SizeText}"
                                     Margin="10,0,0,0" MinWidth="58" TextAlignment="Right"
                                     VerticalAlignment="Center" />

                          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="caption"
                                     Text="{Binding TypesText}" Margin="0,2,0,0" />

                          <!-- A bar rather than a percentage: the point of the size profile is
                               to spot the one path that dwarfs the rest, which is a shape. -->
                          <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Classes="meter"
                                       Height="3" Margin="0,6,0,0"
                                       Minimum="0" Maximum="1" Value="{Binding Share}" />

                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Panel>
              </DockPanel>
            </TabItem>

            <!-- ................................................................. Diff -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="Diff" VerticalAlignment="Center" />
                  <Border Classes="chip" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.HasDifferences}">
                    <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.DifferenceCountText}" />
                  </Border>
                </StackPanel>
              </TabItem.Header>

              <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,10"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.HasResult}">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="caption" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.TabTitle}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.Summary}" />
                  </StackPanel>
                </Border>

                <Panel>
                  <TextBlock Classes="secondary" MaxWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             TextAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.HasResult}"
                             Text="Use Compare to open the comparison, then choose a document on each side. Objects are matched by key, so reordering and reformatting are not reported as changes." />

                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="320">
                    <StackPanel.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.HasResult" />
                        <Binding Path="!$parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.HasDifferences" />
                      </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Text="No differences" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                               Text="The two documents hold the same values, whatever their key order or formatting." />
                  </StackPanel>

                  <ListBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.Differences}" SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.SelectedDifference}"
                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Comparison.HasDifferences}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiffRowViewModel">
                        <StackPanel Spacing="4">

                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Classes="diff"
                                    Classes.added="{Binding IsAdded}"
                                    Classes.removed="{Binding IsRemoved}"
                                    Classes.changed="{Binding IsChanged}">
                              <TextBlock Text="{Binding KindLabel}" />
                            </Border>
                            <TextBlock Classes="path" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>

                          <!-- A change shows both sides; an addition or a removal has only
                               one, and pairing it with an empty column reads as a loss. -->
                          <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding ShowsBothSides}">
                            <TextBlock Grid.Column="0" Classes="side before" Text="{Binding LeftValue}" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="→" Margin="8,0" />
                            <TextBlock Grid.Column="2" Classes="side after" Text="{Binding RightValue}" />
                          </Grid>

                          <TextBlock Classes="side"
                                     Classes.before="{Binding IsRemoved}"
                                     Classes.after="{Binding IsAdded}"
                                     Text="{Binding OnlyValue}"
                                     IsVisible="{Binding !ShowsBothSides}" />

                          <TextBlock Classes="caption" Text="{Binding TypeNote}"
                                     IsVisible="{Binding HasTypeNote}" />

                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Panel>
              </DockPanel>
            </TabItem>

            <!-- ............................................................... Search -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="Search" VerticalAlignment="Center" />
                  <Border Classes="chip" IsVisible="{Binding HasHits}">
                    <TextBlock Text="{Binding HitCountText}" />
                  </Border>
                </StackPanel>
              </TabItem.Header>

              <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,10"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                        IsVisible="{Binding SearchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Classes="caption" Text="{Binding SearchSummary}" TextWrapping="Wrap" />
                </Border>

                <ListBox ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHitRowViewModel">
                      <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Classes="path" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                          <Border Classes="chip">
                            <TextBlock Text="{Binding TargetLabel}" />
                          </Border>
                        </StackPanel>
                        <ctl:HighlightTextBlock Classes="value"
                                                Classes.string="{Binding IsString}"
                                                Classes.number="{Binding IsNumber}"
                                                Classes.boolean="{Binding IsBoolean}"
                                                Classes.nullvalue="{Binding IsNull}"
                                                Text="{Binding Snippet}"
                                                Highlight="{Binding Highlight}"
                                                MatchBackground="{DynamicResource MatchBackground}"
                                                MatchForeground="{DynamicResource MatchForeground}"
                                                FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>

          </TabControl>
        </Border>

      </Grid>

          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>
  </DockPanel>
</Window>
