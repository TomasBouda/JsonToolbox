<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens for the "ops console" look shared by the desktop applications. Every colour
    used anywhere in the UI is named here and defined once per theme, so that adding a control
    never means picking a colour and no screen can end up light-only. The light palette is a
    deliberate palette, not an inversion of the dark one.

    The first block is the shared set, kept in step with the reference implementation; what
    follows is this application's own — the JSON value colouring, the severity and diff
    tints, and the search markup — defined in the same two-palette shape.
  -->

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas, monospace</FontFamily>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgColor">#0B0C10</Color>
      <Color x:Key="BgEditorColor">#0E0F14</Color>
      <Color x:Key="BgElevatedColor">#111218</Color>
      <Color x:Key="PanelColor">#05FFFFFF</Color>
      <Color x:Key="HairlineColor">#14FFFFFF</Color>
      <Color x:Key="HairlineStrongColor">#33FFFFFF</Color>
      <Color x:Key="HoverColor">#0AFFFFFF</Color>
      <Color x:Key="SelectedColor">#0DFFFFFF</Color>
      <Color x:Key="ActiveColor">#1AFFFFFF</Color>
      <Color x:Key="TextColor">#E6E7EB</Color>
      <Color x:Key="TextSecondaryColor">#9A9CA6</Color>
      <Color x:Key="TextMutedColor">#6F7280</Color>
      <Color x:Key="TextFaintColor">#3F4250</Color>
      <Color x:Key="AccentColor">#6C93FF</Color>
      <Color x:Key="AccentSoftColor">#1A6C93FF</Color>
      <Color x:Key="AccentBorderColor">#596C93FF</Color>
      <Color x:Key="RunningColor">#34D399</Color>
      <Color x:Key="RunningSoftColor">#1F34D399</Color>
      <Color x:Key="WarnColor">#FBBF24</Color>
      <Color x:Key="WarnSoftColor">#1FFBBF24</Color>
      <Color x:Key="ErrorColor">#F87171</Color>
      <Color x:Key="ErrorSoftColor">#14F87171</Color>
      <Color x:Key="InfoColor">#8FB3E8</Color>
      <Color x:Key="InfoSoftColor">#1F8FB3E8</Color>
      <Color x:Key="StoppedColor">#4B4F5C</Color>
      <Color x:Key="ScrimColor">#9E05060A</Color>
      <Color x:Key="ShadowColor">#99000000</Color>

      <!-- Value colouring, the same convention code editors use for JSON. -->
      <Color x:Key="SyntaxKeyColor">#DDE3EC</Color>
      <Color x:Key="SyntaxStringColor">#FF8A80</Color>
      <Color x:Key="SyntaxNumberColor">#5FD48A</Color>
      <Color x:Key="SyntaxBooleanColor">#C79BFF</Color>
      <Color x:Key="SyntaxNullColor">#F0A94A</Color>
      <Color x:Key="SyntaxNullSoftColor">#2EE5A94A</Color>
      <Color x:Key="SyntaxContainerColor">#8A93A1</Color>

      <!-- Search markup: a wash rather than a fill, so a marked run stays readable in
           whatever colour its value already had. -->
      <Color x:Key="MatchBackgroundColor">#59B98A00</Color>
      <Color x:Key="MatchForegroundColor">#FFF2CC</Color>

      <Color x:Key="DiffAddedColor">#5FD48A</Color>
      <Color x:Key="DiffRemovedColor">#FF7A7D</Color>
      <Color x:Key="DiffChangedColor">#7FB3FF</Color>
      <Color x:Key="DiffAddedSoftColor">#265FD48A</Color>
      <Color x:Key="DiffRemovedSoftColor">#26FF7A7D</Color>
      <Color x:Key="DiffChangedSoftColor">#267FB3FF</Color>
      <Color x:Key="DiffAddedMarkColor">#995FD48A</Color>
      <Color x:Key="DiffRemovedMarkColor">#99FF7A7D</Color>

      <Color x:Key="MeterTrackColor">#2A2F38</Color>
      <Color x:Key="MeterFillColor">#806C93FF</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="BgColor">#F5F5F7</Color>
      <Color x:Key="BgEditorColor">#FFFFFF</Color>
      <Color x:Key="BgElevatedColor">#FFFFFF</Color>
      <Color x:Key="PanelColor">#E6FFFFFF</Color>
      <Color x:Key="HairlineColor">#17000000</Color>
      <Color x:Key="HairlineStrongColor">#38000000</Color>
      <Color x:Key="HoverColor">#0A000000</Color>
      <Color x:Key="SelectedColor">#0F000000</Color>
      <Color x:Key="ActiveColor">#1F000000</Color>
      <Color x:Key="TextColor">#16171D</Color>
      <Color x:Key="TextSecondaryColor">#5C5F6B</Color>
      <Color x:Key="TextMutedColor">#6F7280</Color>
      <Color x:Key="TextFaintColor">#B0B3BE</Color>
      <Color x:Key="AccentColor">#2A57C9</Color>
      <Color x:Key="AccentSoftColor">#1A2A57C9</Color>
      <Color x:Key="AccentBorderColor">#662A57C9</Color>
      <Color x:Key="RunningColor">#16A34A</Color>
      <Color x:Key="RunningSoftColor">#1F16A34A</Color>
      <Color x:Key="WarnColor">#B45309</Color>
      <Color x:Key="WarnSoftColor">#1FB45309</Color>
      <Color x:Key="ErrorColor">#DC2626</Color>
      <Color x:Key="ErrorSoftColor">#14DC2626</Color>
      <Color x:Key="InfoColor">#4C74B8</Color>
      <Color x:Key="InfoSoftColor">#1F4C74B8</Color>
      <Color x:Key="StoppedColor">#B8BAC4</Color>
      <Color x:Key="ScrimColor">#66F5F5F7</Color>
      <Color x:Key="ShadowColor">#33000000</Color>

      <Color x:Key="SyntaxKeyColor">#1F2430</Color>
      <Color x:Key="SyntaxStringColor">#A31515</Color>
      <Color x:Key="SyntaxNumberColor">#12763C</Color>
      <Color x:Key="SyntaxBooleanColor">#7A3EAF</Color>
      <Color x:Key="SyntaxNullColor">#9A4B00</Color>
      <Color x:Key="SyntaxNullSoftColor">#1FB06A00</Color>
      <Color x:Key="SyntaxContainerColor">#6E7683</Color>

      <Color x:Key="MatchBackgroundColor">#66FFD54A</Color>
      <Color x:Key="MatchForegroundColor">#3A2A00</Color>

      <Color x:Key="DiffAddedColor">#12763C</Color>
      <Color x:Key="DiffRemovedColor">#C7292E</Color>
      <Color x:Key="DiffChangedColor">#2A57C9</Color>
      <Color x:Key="DiffAddedSoftColor">#1F12763C</Color>
      <Color x:Key="DiffRemovedSoftColor">#1FC7292E</Color>
      <Color x:Key="DiffChangedSoftColor">#1F2A57C9</Color>
      <Color x:Key="DiffAddedMarkColor">#6612763C</Color>
      <Color x:Key="DiffRemovedMarkColor">#66C7292E</Color>

      <Color x:Key="MeterTrackColor">#E6E8EC</Color>
      <Color x:Key="MeterFillColor">#802A57C9</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Brushes resolve the theme-specific colours above; styles and views bind to these. -->
  <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}" />
  <SolidColorBrush x:Key="BgEditorBrush" Color="{DynamicResource BgEditorColor}" />
  <SolidColorBrush x:Key="BgElevatedBrush" Color="{DynamicResource BgElevatedColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{DynamicResource HairlineColor}" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="{DynamicResource HairlineStrongColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{DynamicResource SelectedColor}" />
  <SolidColorBrush x:Key="ActiveBrush" Color="{DynamicResource ActiveColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextFaintBrush" Color="{DynamicResource TextFaintColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="{DynamicResource AccentBorderColor}" />
  <SolidColorBrush x:Key="RunningBrush" Color="{DynamicResource RunningColor}" />
  <SolidColorBrush x:Key="RunningSoftBrush" Color="{DynamicResource RunningSoftColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="{DynamicResource WarnSoftColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
  <SolidColorBrush x:Key="ErrorSoftBrush" Color="{DynamicResource ErrorSoftColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="{DynamicResource InfoSoftColor}" />
  <SolidColorBrush x:Key="StoppedBrush" Color="{DynamicResource StoppedColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{DynamicResource ScrimColor}" />

  <SolidColorBrush x:Key="SyntaxKey" Color="{DynamicResource SyntaxKeyColor}" />
  <SolidColorBrush x:Key="SyntaxString" Color="{DynamicResource SyntaxStringColor}" />
  <SolidColorBrush x:Key="SyntaxNumber" Color="{DynamicResource SyntaxNumberColor}" />
  <SolidColorBrush x:Key="SyntaxBoolean" Color="{DynamicResource SyntaxBooleanColor}" />
  <SolidColorBrush x:Key="SyntaxNull" Color="{DynamicResource SyntaxNullColor}" />
  <SolidColorBrush x:Key="SyntaxNullSoft" Color="{DynamicResource SyntaxNullSoftColor}" />
  <SolidColorBrush x:Key="SyntaxContainer" Color="{DynamicResource SyntaxContainerColor}" />
  <SolidColorBrush x:Key="MatchBackground" Color="{DynamicResource MatchBackgroundColor}" />
  <SolidColorBrush x:Key="MatchForeground" Color="{DynamicResource MatchForegroundColor}" />
  <SolidColorBrush x:Key="DiffAdded" Color="{DynamicResource DiffAddedColor}" />
  <SolidColorBrush x:Key="DiffRemoved" Color="{DynamicResource DiffRemovedColor}" />
  <SolidColorBrush x:Key="DiffChanged" Color="{DynamicResource DiffChangedColor}" />
  <SolidColorBrush x:Key="DiffAddedSoft" Color="{DynamicResource DiffAddedSoftColor}" />
  <SolidColorBrush x:Key="DiffRemovedSoft" Color="{DynamicResource DiffRemovedSoftColor}" />
  <SolidColorBrush x:Key="DiffChangedSoft" Color="{DynamicResource DiffChangedSoftColor}" />
  <SolidColorBrush x:Key="DiffAddedMark" Color="{DynamicResource DiffAddedMarkColor}" />
  <SolidColorBrush x:Key="DiffRemovedMark" Color="{DynamicResource DiffRemovedMarkColor}" />
  <SolidColorBrush x:Key="MeterTrack" Color="{DynamicResource MeterTrackColor}" />
  <SolidColorBrush x:Key="MeterFill" Color="{DynamicResource MeterFillColor}" />

  <!-- The braces keep their blue in both themes: they are the logo, not a text colour. -->
  <SolidColorBrush x:Key="LogoBrush" Color="#5C85FA" />

  <!-- Fluent resources the built-in control templates read; pointing them at the accent keeps
       focus rings, selection and text inputs on-palette without re-templating every control. -->
  <Color x:Key="SystemAccentColor">#3B6FF5</Color>
  <Color x:Key="SystemAccentColorDark1">#2A57C9</Color>
  <Color x:Key="SystemAccentColorDark2">#20449E</Color>
  <Color x:Key="SystemAccentColorDark3">#173373</Color>
  <Color x:Key="SystemAccentColorLight1">#5C85FA</Color>
  <Color x:Key="SystemAccentColorLight2">#84A3FB</Color>
  <Color x:Key="SystemAccentColorLight3">#ADC2FD</Color>

</ResourceDictionary>
