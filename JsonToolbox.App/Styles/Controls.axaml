<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:JsonToolbox.App.Controls"
        xmlns:i="https://github.com/projektanker/icons.avalonia">

  <!--
    Control styling for the "ops console" look: hairline borders, 5–6 px radii, a single accent,
    and short (≤ 250 ms) ease-out motion. Fluent stays underneath so that focus handling,
    keyboard behaviour and animation stay correct; this file only changes appearance, and every
    colour comes from Tokens.axaml rather than being written here.

    The first half is the shared set, kept in step with the reference implementation; the
    second half is what this application adds — value colouring, the tree rows, the diff and
    the table.
  -->

  <Styles.Resources>
    <!-- Tab strip: 12 px labels with a 1 px accent underline instead of Fluent's large pipe tabs. -->
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="18" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <DockPanel>
              <Border DockPanel.Dock="Top"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource HairlineBrush}"
                      Padding="16,0">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Border>
              <ContentPresenter Name="PART_SelectedContentHost"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                Margin="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Panel>
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center" />
              <Border Name="PART_SelectedPipe"
                      Height="1"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,-9"
                      Background="{DynamicResource AccentBrush}"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- ===== Window and typography ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector=":is(TextBlock).mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector=":is(TextBlock).secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <!-- Small uppercase section label (write the text in capitals). -->
  <Style Selector=":is(TextBlock).section">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).h">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector=":is(TextBlock).title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.card.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
  </Style>
  <Style Selector="Border.card.error">
    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="Border.hairline-b">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.hairline-t">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.hairline-r">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.hairline-l">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.vsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Chips and keyboard hints -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.chip.running">
    <Setter Property="Background" Value="{DynamicResource RunningSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.running > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RunningBrush}" />
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button > StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="Button > StackPanel > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The one highlighted action. -->
  <Style Selector="Button.primary">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Borderless 28 px icon button (header, inline actions). -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Text-only button used inside lists and headers. -->
  <Style Selector="Button.ghost">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- Toggle chips: modifiers on one action, which a row of chips reads as a group in a way
       a row of checkbox labels does not. -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <!-- Borderless input, for a field that sits inside another box and must not draw its own. -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <!-- The value editor: a code box on the editor background, no chrome of its own. -->
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource BgEditorBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="TextBox.code:pointerover /template/ Border#PART_BorderElement, TextBox.code:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BgEditorBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
  </Style>

  <!-- ===== Lists ===== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Row lists: hover fill + 2 px accent bar on the left, selected keeps the bar. -->
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="10,9,12,9" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="2,0,0,0"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.1" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Name="Content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.rows.compact ListBoxItem">
    <Setter Property="Padding" Value="10,6,10,6" />
  </Style>

  <!-- ===== Motion ===== -->
  <!-- Content fades up 4 px when it appears; d1..d4 stagger sibling blocks by 40 ms. -->
  <Style Selector=":is(Control).fade-in">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Both">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).fade-in.d1">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.04" Easing="CubicEaseOut" FillMode="Both">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).fade-in.d2">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.08" Easing="CubicEaseOut" FillMode="Both">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Command palette: pops in from above while the scrim fades. -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
    <Style.Animations>
      <Animation Duration="0:0:0.15" FillMode="Both">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.popin">
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Both">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== Shared odds and ends ===== -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="6" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource MeterTrack}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <!-- A bar used as a data mark rather than as feedback: quieter, so a list of them reads
       as a chart and not as a screen full of running tasks. -->
  <Style Selector="ProgressBar.meter">
    <Setter Property="Foreground" Value="{DynamicResource MeterFill}" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================================================================================
       What this application adds
       =================================================================================== -->

  <!-- Value colouring, driven by classes the row sets from the node's kind. -->
  <Style Selector=":is(TextBlock).value">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector=":is(TextBlock).value.string">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxString}" />
  </Style>
  <Style Selector=":is(TextBlock).value.number">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxNumber}" />
  </Style>
  <Style Selector=":is(TextBlock).value.boolean">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxBoolean}" />
  </Style>
  <!-- A null is given a wash of its own rather than being greyed out. It is not an absence of
       interest — it is usually the thing you are looking for — and a grey value is the one
       colour a reader's eye skips. -->
  <Style Selector=":is(TextBlock).value.nullvalue">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxNull}" />
    <Setter Property="Background" Value="{DynamicResource SyntaxNullSoft}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector=":is(TextBlock).value.container">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxContainer}" />
  </Style>

  <Style Selector=":is(TextBlock).key">
    <Setter Property="Foreground" Value="{DynamicResource SyntaxKey}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector=":is(TextBlock).path">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Severity badges: chips coloured by what they say. -->
  <Style Selector="Border.severity">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.severity > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Border.severity.error">
    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
  </Style>
  <Style Selector="Border.severity.error > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="Border.severity.warning">
    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
  </Style>
  <Style Selector="Border.severity.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Border.severity.info">
    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
  </Style>
  <Style Selector="Border.severity.info > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
  </Style>

  <!-- A pane header: a hairline under a row of section labels and chips. -->
  <Style Selector="Border.paneHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="38" />
  </Style>

  <!-- The trailing row of a partly shown container. Reads as a quiet link rather than as a
       button, so it does not compete with the data above it. -->
  <Style Selector="Button.more">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.more:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- Pinned values sit beside a collapsed container as a quiet aside: they are context for
       the row, not the row itself. -->
  <Style Selector=":is(TextBlock).pinned">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="Border.chip.pin">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.chip.pin > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- The row expander. A flat list has no notion of nesting, so the chevron is part of the
       row; it points right when closed and down when open. -->
  <Style Selector="Button.expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.expander:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- Tree and text rows are one line tall and evenly spaced: that uniformity is what lets
       the list virtualise exactly instead of estimating. They keep the accent bar of every
       row list, but are tighter than a list of sites. -->
  <Style Selector="ListBox.tree ListBoxItem">
    <Setter Property="Padding" Value="8,3,10,3" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="ListBox.text ListBoxItem">
    <Setter Property="Padding" Value="8,2,10,2" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="TextBlock.lineNumber">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Diff badges. Same shape as the severity badges so the two panels read alike. -->
  <Style Selector="Border.diff">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.diff > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Border.diff.added">
    <Setter Property="Background" Value="{DynamicResource DiffAddedSoft}" />
  </Style>
  <Style Selector="Border.diff.added > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DiffAdded}" />
  </Style>
  <Style Selector="Border.diff.removed">
    <Setter Property="Background" Value="{DynamicResource DiffRemovedSoft}" />
  </Style>
  <Style Selector="Border.diff.removed > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DiffRemoved}" />
  </Style>
  <Style Selector="Border.diff.changed">
    <Setter Property="Background" Value="{DynamicResource DiffChangedSoft}" />
  </Style>
  <Style Selector="Border.diff.changed > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DiffChanged}" />
  </Style>
  <Style Selector=":is(TextBlock).side">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector=":is(TextBlock).side.before">
    <Setter Property="Foreground" Value="{DynamicResource DiffRemoved}" />
  </Style>
  <Style Selector=":is(TextBlock).side.after">
    <Setter Property="Foreground" Value="{DynamicResource DiffAdded}" />
  </Style>

  <!-- Diff rows are tinted by what happened to them, the way a text diff tints its lines. -->
  <Style Selector="ListBox.diffrows ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Border.diffrow">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.diffrow.added">
    <Setter Property="Background" Value="{DynamicResource DiffAddedSoft}" />
  </Style>
  <Style Selector="Border.diffrow.removed">
    <Setter Property="Background" Value="{DynamicResource DiffRemovedSoft}" />
  </Style>
  <Style Selector="Border.diffrow.changed">
    <Setter Property="Background" Value="{DynamicResource DiffChangedSoft}" />
  </Style>

  <!-- The changed part of a value. Green where it arrived, red where it went. -->
  <Style Selector="ctl|DiffValueTextBlock.markadded">
    <Setter Property="MarkBackground" Value="{DynamicResource DiffAddedMark}" />
  </Style>
  <Style Selector="ctl|DiffValueTextBlock.markremoved">
    <Setter Property="MarkBackground" Value="{DynamicResource DiffRemovedMark}" />
  </Style>

  <!-- Document tabs: the same 12 px label and 1 px accent underline as the panel tabs, so the
       two tab strips in the window read as the same idea at two scales. -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tab.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tabclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- ===== Table ===== -->
  <!-- The header sits still while the rows scroll under it, and both are drawn from the same
       list of columns at the same fixed widths, which is what keeps them lined up without a
       grid whose two halves would have to be kept in step. -->
  <Style Selector="Border.tablehead">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,7" />
  </Style>
  <!-- The heading is a button, because clicking it sorts. It is styled to look like a heading
       rather than like a button: the thing it does is discovered by trying it, and a row of
       buttons across the top of a table would read as a toolbar. -->
  <Style Selector="Button.tableheadcell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tableheadcell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.tableheadcell.sorted">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- The row number, which is the one thing a table of records cannot infer from its data. -->
  <Style Selector="TextBlock.tablecorner">
    <Setter Property="Width" Value="64" />
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.tablecell">
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
